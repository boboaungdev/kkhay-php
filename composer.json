{
  "name": "kkhay/kkhay",
  "description": "Official PHP SDK for K Khay — The Non-Custodial Crypto Payment Gateway",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "K Khay",
      "email": "dev@kkhay.com",
      "homepage": "https://kkhay.com"
    }
  ],
  "homepage": "https://kkhay.com",
  "keywords": [
    "kkhay",
    "crypto",
    "cryptocurrency",
    "payments",
    "payment-gateway",
    "woocommerce",
    "wordpress",
    "laravel",
    "web3",
    "usdt",
    "usdc",
    "bsc",
    "polygon",
    "arbitrum",
    "base",
    "ethereum",
    "bitcoin",
    "solana",
    "ton",
    "tron",
    "xrpl",
    "invoice"
  ],
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-hash": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5 || ^10.0 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "Kkhay\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kkhay\\Tests\\": "tests/"
    }
  },
  "minimum-stability": "stable"
}
